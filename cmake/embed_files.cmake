# nevermore_embed_files(<output.c> <symbol> <file> [<symbol> <file> ...])
#
# Writes a C source defining, for each pair:
#   uint8_t const <symbol>[];  size_t const <symbol>_size;
# Done at configure time; editing an input re-runs the configure step.
function(nevermore_embed_files out)
  set(content "// Generated by cmake/embed_files.cmake. Do not edit.\n#include <stddef.h>\n#include <stdint.h>\n\n")
  set(args ${ARGN})
  list(LENGTH args n)
  math(EXPR last "${n} - 1")
  foreach(i RANGE 0 ${last} 2)
    math(EXPR j "${i} + 1")
    list(GET args ${i} symbol)
    list(GET args ${j} file)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")

    file(READ "${file}" hex HEX)
    file(SIZE "${file}" size)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND content "uint8_t const ${symbol}[] = {${bytes}};\nsize_t const ${symbol}_size = ${size};\n\n")
  endforeach()

  file(CONFIGURE OUTPUT "${out}" CONTENT "${content}" @ONLY)
endfunction()
